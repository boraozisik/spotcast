# Copy this file to .env:  cp .env.example .env
# .env is git-ignored. Docker Compose and the Python app both read it.

# Used by Docker Compose to create the database container
POSTGRES_USER=spotcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spotcast
POSTGRES_PORT=5440

# Used by the Python app (must match the values above)
DATABASE_URL=postgresql+psycopg://spotcast:change-me@localhost:5440/spotcast
